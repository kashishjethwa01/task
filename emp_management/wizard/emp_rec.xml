<odoo>

	<!-- Form views of emp.rec models -->
	<record id = "view_emp_master_wizard_form" model="ir.ui.view">
		<field name="name">wizard form view</field>
		<field name="model">emp.master.wizard</field>
		<field name="arch" type="xml">
			<form string="Wizard">
				<group>
					<field name="file"/>
				</group>
				<footer>
					<button name="action_import_employees" type="object" string="Upload" class="btn-primary"/>
		   			<button string="Cancel" class="btn-secondary" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="emp_master_wizard_action_id" model="ir.actions.act_window">
    <field name="name">Update Employee Info</field>
    <field name="res_model">emp.master.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>


   <record id="action_emp_master_wizard" model="ir.actions.act_window">
    <field name="name">Upload Employees</field>
    <field name="res_model">emp.master.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>

</record>

</odoo>
